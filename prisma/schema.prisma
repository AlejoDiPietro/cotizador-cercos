// Modelo de datos del cotizador.
//
// La decision que ordena todo este archivo: una cotizacion guardada NO se
// recalcula. Guarda el pedido, pero tambien cada renglon y cada precio del dia
// en que se hizo. Si manana sube el tejido, la cotizacion que le mande al
// cliente la semana pasada tiene que seguir diciendo lo mismo que decia cuando
// la mando, porque es una oferta con la que el cliente puede venir a reclamar.
//
// Es la misma razon por la que una factura no consulta la lista de precios: la
// congela. Un cotizador que recalcula al abrir el link es un cotizador que le
// cambia el precio al cliente sin avisarle.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Postgres.
//
// Arranco en SQLite y el salto costo exactamente lo que decia que iba a costar:
// esta linea y el adapter en src/server/db.ts. Ni un modelo, ni un campo, ni una
// consulta. Eso es lo que se gana con no usar tipos propios de un motor: el
// pedido guardado como texto y no como `Json`, la plata como enteros y ningun
// atributo `@db.` de Postgres.
datasource db {
  provider = "postgresql"
}

/// La lista de precios, que es lo unico de este proyecto que cambia todas las
/// semanas. Se edita desde /productos.
///
/// El calculo NO lee esta tabla: la recibe como argumento. Por eso sigue siendo
/// una funcion pura aunque los precios vivan acá.
model Producto {
  /// El codigo del material ES la identidad: no hace falta un id sintetico
  /// arriba de algo que ya es unico y estable. Es el mismo string que queda
  /// escrito en cada renglon de una cotizacion vieja.
  codigo String @id

  nombre String
  unidad String

  /// Lo que se le cobra al cliente, en centavos y sin IVA.
  precio Int

  /// Lo que cuesta comprarlo, en centavos. Nunca sale impreso en una
  /// cotizacion: existe para saber si el trabajo deja plata.
  costo Int

  /// El precio de antes del ultimo cambio, para poder mostrar cuanto se movio.
  /// Con inflacion, "hace 40 dias que no toco este precio" es un dato de
  /// gestion, no un detalle de interfaz.
  precioAnterior Int?

  actualizadoEl DateTime @updatedAt

  /// El orden en que se listan. Sin esto la lista de precios baila en cada
  /// consulta y no hay forma de encontrar un renglon dos veces en el mismo lugar.
  orden Int @default(0)
}

model Cotizacion {
  id String @id @default(cuid())

  /// Codigo corto para el link publico. No es el id: el id es interno y
  /// secuencialmente adivinable no sirve para algo que se comparte por WhatsApp.
  codigo String @unique

  cliente String?
  obra    String?
  notas   String?

  creadaEl DateTime @default(now())

  /// El pedido tal como lo cargaron, para poder reabrirlo en el formulario y
  /// cotizar una variante sin empezar de cero.
  ///
  /// Texto y no `Json`: `Json` no existe en todos los motores, y de todas
  /// formas lo que sale de la base se valida con Zod al leerlo. Un blob que
  /// guardo yo el mes pasado no es mas confiable que uno que manda un cliente.
  pedido String

  /// Totales congelados, en CENTAVOS y sin IVA salvo `total`.
  materiales Int
  manoDeObra Int
  subtotal   Int
  iva        Int
  total      Int

  items Item[]

  @@index([creadaEl])
}

model Item {
  id String @id @default(cuid())

  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  /// Que material es. Es un string y no una relacion a proposito: si el
  /// catalogo cambia o se deja de vender un articulo, el renglon de una
  /// cotizacion vieja tiene que seguir existiendo igual.
  codigo      String
  descripcion String
  unidad      String

  /// Hay cantidades fraccionarias (kg de alambre de atadura), asi que no es Int.
  /// Decimal y no Float: con Float, 0.1 + 0.2 no da 0.3.
  cantidad Decimal

  /// En centavos, sin IVA.
  precioUnitario Int
  subtotal       Int

  /// El orden en que se imprime. Sin esto, el PDF sale distinto cada vez.
  orden Int

  @@index([cotizacionId])
}
